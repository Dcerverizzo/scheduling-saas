generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyRole {
  OWNER
  STAFF
}

enum AvailabilityExceptionType {
  BLOCK
  AVAILABLE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingEventType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_RESCHEDULED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  BOOKING_NO_SHOW
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
}

enum AvailabilityExceptionSource {
  MANUAL
  GOOGLE_CALENDAR
}

// ERROR cobre tanto token revogado (staff desconectou direto na conta Google) quanto qualquer
// falha de sync persistente — dispara o banner "Google Calendar desconectado" no dashboard
// (decisão 9 do design de Calendar no PRD) até o staff reconectar.
enum GoogleCalendarConnectionStatus {
  CONNECTED
  ERROR
}

// Tiers da assinatura da própria SaaS (dono do salão paga a plataforma) — enum + config em
// código (packages/domain/src/plans/plan-config.ts), não tabela: não existe admin UI pra
// gerenciar planos ainda, e trocar preço/limite de um tier não deve exigir migration.
enum PlanTier {
  FREE
  STARTER
  PRO
}

// Campo denormalizado em Company (lido em todo request tenant-scoped, sem join). INCOMPLETE
// cobre o intervalo entre "preapproval criada" e "payer autorizou no Mercado Pago" — Company
// nasce TRIALING (ver trialEndsAt), nunca INCOMPLETE, até uma assinatura real ser iniciada.
enum CompanySubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// Status da CompanySubscription (bookkeeping específico do Mercado Pago) — eixo diferente de
// CompanySubscriptionStatus: este é o estado da preapproval no MP, aquele é o que o resto do
// app lê pra gating de feature.
enum PlatformSubscriptionStatus {
  PENDING
  AUTHORIZED
  PAUSED
  CANCELLED
}

// Configuração por empresa de exigência de pagamento no momento do booking — NONE mantém o
// comportamento atual (booking direto pra CONFIRMED), DEPOSIT/FULL fazem o booking nascer
// PENDING até o webhook do Mercado Pago confirmar (ver Payment).
enum PaymentRequirement {
  NONE
  DEPOSIT
  FULL
}

enum PaymentType {
  FULL
  DEPOSIT
}

// EXPIRED é resultado da reconciliação periódica (Payment.expiresAt vencido sem aprovação) —
// não vem do Mercado Pago. Um Payment REJECTED/CANCELLED/EXPIRED cancela o Booking associado;
// não existe retry no mesmo Payment, uma nova tentativa é um Booking novo (mantém a garantia da
// exclusion constraint simples — só PENDING/CONFIRMED bloqueiam o slot).
enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
  EXPIRED
}

// email/passwordHash são opcionais por causa do agendamento sem conta (Fase 2):
// um User "convidado" (isGuest=true) nasce só com nome+telefone, sem credencial
// nenhuma — nunca consegue logar via Credentials (authorize() exige
// passwordHash). Unique em email continua valendo com múltiplos NULL (Postgres
// permite), mesmo padrão já usado em Booking.idempotencyKey.
model User {
  id                 String    @id @default(uuid())
  name               String
  email              String?   @unique
  emailVerifiedAt    DateTime?
  phone              String?
  phoneVerifiedAt    DateTime?
  passwordHash       String?
  mustChangePassword Boolean   @default(false)
  isGuest            Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts        Account[]
  sessions        Session[]
  companyMembers  CompanyMember[]
  staffProfiles   StaffProfile[]
  customerProfile CustomerProfile?

  @@map("users")
}

// Account/Session/VerificationToken seguem o schema de referência do Auth.js PrismaAdapter.
// A estratégia de sessão do MVP é "jwt" (exigida pelo Credentials provider), então essas
// tabelas ficam inertes por enquanto — mantidas prontas para quando um provider OAuth for
// adicionado na Fase 2, sem precisar de nova migration.
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Company {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  phone        String?
  timezone     String  @default("America/Sao_Paulo")
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String  @default("BR")

  // Assinatura da SaaS (billing do dono) — denormalizado aqui pra leitura sem join em todo
  // gating de plano; CompanySubscription abaixo guarda o bookkeeping do lado do Mercado Pago.
  plan               PlanTier                   @default(FREE)
  subscriptionStatus CompanySubscriptionStatus  @default(TRIALING)
  trialEndsAt        DateTime?

  // Exigência de pagamento no momento do booking (cliente final → empresa). depositPercentage
  // só é obrigatório na aplicação quando paymentRequirement = DEPOSIT (não no schema — mesmo
  // padrão de campo opcional condicional já usado em GoogleCalendarConnection).
  paymentRequirement PaymentRequirement @default(NONE)
  depositPercentage  Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members                   CompanyMember[]
  staff                     StaffProfile[]
  services                  Service[]
  availabilityRules         AvailabilityRule[]
  availabilityExceptions    AvailabilityException[]
  bookings                  Booking[]
  bookingEvents             BookingEvent[]
  notificationLogs          NotificationLog[]
  googleCalendarConnections GoogleCalendarConnection[]
  bookingCalendarEvents     BookingCalendarEvent[]
  subscription              CompanySubscription?
  payments                  Payment[]

  @@map("companies")
}

model CompanyMember {
  id        String      @id @default(uuid())
  companyId String
  userId    String
  role      CompanyRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

model StaffProfile {
  id          String  @id @default(uuid())
  companyId   String
  userId      String
  displayName String
  phone       String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  services                 ServiceStaff[]
  availabilityRules        AvailabilityRule[]
  availabilityExceptions   AvailabilityException[]
  bookings                 Booking[]
  googleCalendarConnection GoogleCalendarConnection?
  bookingCalendarEvents    BookingCalendarEvent[]

  @@unique([companyId, userId])
  @@index([companyId])
  @@map("staff_profiles")
}

model CustomerProfile {
  id     String  @id @default(uuid())
  userId String  @unique
  phone  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("customer_profiles")
}

model Service {
  id                  String  @id @default(uuid())
  companyId           String
  name                String
  description         String?
  durationMinutes     Int
  bufferBeforeMinutes Int     @default(0)
  bufferAfterMinutes  Int     @default(0)
  priceInCents        Int
  currency            String  @default("BRL")
  active              Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff    ServiceStaff[]
  bookings Booking[]

  @@index([companyId])
  @@map("services")
}

model ServiceStaff {
  serviceId String
  staffId   String

  createdAt DateTime @default(now())

  service Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff   StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([serviceId, staffId])
  @@index([staffId])
  @@map("service_staff")
}

// startTime/endTime são "HH:mm" em horário LOCAL da empresa (não UTC) — a conversão
// pra instante absoluto só acontece na hora de calcular slots (ver packages/domain).
model AvailabilityRule {
  id         String    @id @default(uuid())
  companyId  String
  staffId    String
  dayOfWeek  Int
  startTime  String
  endTime    String
  validFrom  DateTime? @db.Date
  validUntil DateTime? @db.Date
  active     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff   StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, dayOfWeek])
  @@map("availability_rules")
}

// startsAt/endsAt aqui SÃO instantes absolutos (UTC) — ao contrário da regra recorrente,
// uma exceção é um evento pontual (ex: "de folga dia 25/12"), então já nasce em UTC.
//
// source/externalEventId existem pro sync inbound do Google Calendar (decisão 3 do design de
// Calendar no PRD): em vez de um motor de disponibilidade novo, evento do Google que bloqueia a
// agenda do staff vira uma exceção normal aqui, com source=GOOGLE_CALENDAR e externalEventId
// apontando pro id do evento no Google — usado pra fazer diff a cada sync (criar/atualizar/apagar
// a exceção correspondente sem tocar nas exceções MANUAL). getAvailableSlots() não muda.
model AvailabilityException {
  id              String                      @id @default(uuid())
  companyId       String
  staffId         String
  type            AvailabilityExceptionType
  startsAt        DateTime
  endsAt          DateTime
  reason          String?
  source          AvailabilityExceptionSource @default(MANUAL)
  externalEventId String?

  createdAt DateTime @default(now())

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff   StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, externalEventId])
  @@index([staffId, startsAt])
  @@map("availability_exceptions")
}

// Proteção definitiva contra double-booking: EXCLUDE constraint com GiST sobre
// (staffId, tsrange(startsAt, endsAt)) pra status PENDING/CONFIRMED, adicionada via
// migration SQL manual (ver prisma/migrations/*_add_booking_exclusion_constraint) —
// Prisma não representa isso no schema declarativo. Essa constraint é a última linha
// de defesa; a checagem de disponibilidade na aplicação é a primeira.
model Booking {
  id         String @id @default(uuid())
  companyId  String
  customerId String
  staffId    String
  serviceId  String

  startsAt DateTime
  endsAt   DateTime

  status BookingStatus @default(CONFIRMED)

  customerNameSnapshot    String
  customerPhoneSnapshot   String?
  serviceNameSnapshot     String
  serviceDurationSnapshot Int
  servicePriceSnapshot    Int

  idempotencyKey String? @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?
  completedAt DateTime?

  company          Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         CustomerProfile       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff            StaffProfile          @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service          Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  events           BookingEvent[]
  notificationLogs NotificationLog[]
  calendarEvent    BookingCalendarEvent?
  payment          Payment?

  @@index([companyId])
  @@index([staffId, startsAt])
  @@index([customerId, startsAt])
  @@map("bookings")
}

model BookingEvent {
  id          String           @id @default(uuid())
  bookingId   String
  companyId   String
  actorUserId String?
  type        BookingEventType
  metadata    Json?

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_events")
}

model NotificationLog {
  id              String  @id @default(uuid())
  companyId       String
  bookingId       String?
  recipientUserId String?

  channel NotificationChannel
  type    NotificationType

  destination       String
  provider          String?
  providerMessageId String?

  status       NotificationStatus @default(QUEUED)
  attemptCount Int                @default(0)

  scheduledFor DateTime?
  sentAt       DateTime?
  deliveredAt  DateTime?
  failedAt     DateTime?

  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([status, scheduledFor])
  @@map("notification_logs")
}

// Conexão OAuth de UM staff com o próprio Google Calendar pessoal (decisão 1 do design de
// Calendar no PRD: por StaffProfile, não por Company — agenda pessoal é do profissional).
// refreshToken é armazenado cifrado na camada de aplicação (não em texto plano) — o schema não
// impõe isso, é responsabilidade de quem grava.
// watchChannelId/watchResourceId/watchExpiresAt só existem depois do primeiro sync (que é quando
// o channel de push notification do Google é criado); ficam null logo após o OAuth.
model GoogleCalendarConnection {
  id                 String                         @id @default(uuid())
  companyId          String
  staffId            String                         @unique
  googleAccountEmail String
  calendarId         String
  refreshToken       String
  scope              String
  syncToken          String?
  watchChannelId     String?
  watchResourceId    String?
  watchExpiresAt     DateTime?
  status             GoogleCalendarConnectionStatus @default(CONNECTED)
  lastSyncedAt       DateTime?
  lastErrorAt        DateTime?
  lastErrorMessage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff   StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([watchExpiresAt])
  @@map("google_calendar_connections")
}

// Rastreia o evento outbound (booking → Google) criado pro app poder atualizar/apagar depois,
// mesmo papel que NotificationLog cumpre pro WhatsApp (decisão 2 do design de Calendar no PRD).
// bookingId é único: reagendamento atualiza o mesmo evento no Google em vez de criar um novo,
// espelhando a decisão 6 da Fase 1 (reagendamento atualiza o mesmo Booking, não cria um novo).
model BookingCalendarEvent {
  id            String @id @default(uuid())
  companyId     String
  staffId       String
  bookingId     String @unique
  googleEventId String
  calendarId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff   StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([staffId])
  @@map("booking_calendar_events")
}

// Bookkeeping da assinatura da SaaS no lado do Mercado Pago — mesmo papel que
// GoogleCalendarConnection cumpre pro Google: uma tabela satélite 1:1 com o tenant, fora do
// hot path de Company, que a reconciliação periódica pode re-sincronizar independente do
// webhook ter chegado ou não. Company.plan/subscriptionStatus/trialEndsAt são a cópia
// denormalizada que o resto do app lê; esta tabela é a fonte de verdade do lado do MP.
model CompanySubscription {
  id                  String                      @id @default(uuid())
  companyId           String                      @unique
  planTier            PlanTier
  mpPreapprovalId     String?                     @unique
  mpPreapprovalPlanId String?
  status              PlatformSubscriptionStatus  @default(PENDING)
  payerEmail          String?
  lastSyncedAt        DateTime?
  lastErrorAt         DateTime?
  lastErrorMessage    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("company_subscriptions")
}

// Pagamento de UM booking (cliente final → empresa, via a plataforma). bookingId é único: sem
// retry no mesmo Payment — um pagamento REJECTED/CANCELLED/EXPIRED cancela o Booking, uma nova
// tentativa é um Booking novo (mantém a exclusion constraint GiST simples, só PENDING/CONFIRMED
// bloqueiam o slot). expiresAt dirige o sweep de reconciliação que cancela booking não pago.
model Payment {
  id              String        @id @default(uuid())
  companyId       String
  bookingId       String        @unique
  type            PaymentType
  amountInCents   Int
  status          PaymentStatus @default(PENDING)

  mpPreferenceId  String? @unique
  mpPaymentId     String? @unique
  mpPaymentMethod String?
  mpStatusDetail  String?

  approvedAt DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@map("payments")
}
