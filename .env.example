# Postgres
# Dev local (docker-compose.yml, porta publicada no host): host = localhost.
# Produção (docker-compose.prod.yml, rede interna do Compose, porta não
# publicada): host = postgres (nome do serviço), nunca localhost.
DATABASE_URL="postgresql://scheduling:scheduling@localhost:5432/scheduling_saas?schema=public"
# POSTGRES_USER/PASSWORD/DB só são lidas pelo container do Postgres em
# docker-compose.prod.yml — têm que bater com o usuário/senha/banco
# codificados na DATABASE_URL acima.
POSTGRES_USER="scheduling"
POSTGRES_PASSWORD="scheduling"
POSTGRES_DB="scheduling_saas"

# Redis (BullMQ)
# Mesma regra do Postgres: localhost em dev, redis (nome do serviço) em prod.
REDIS_URL="redis://localhost:6379"

# Auth.js
# generate with: npx auth secret
AUTH_SECRET=""
# Dev: http://localhost:3000. Produção: URL pública real (https://...).
AUTH_URL="http://localhost:3000"

# App
NODE_ENV="development"

# WhatsApp — "console" loga a mensagem no terminal do worker (padrão pra dev local,
# não abre conexão nenhuma). "baileys" conecta de verdade (produção) — nunca use
# número pessoal, ver README > WhatsApp (desenvolvimento).
WHATSAPP_PROVIDER="console"

# Google Calendar (Fase 2) — OAuth por staff, ver PRD "Google Calendar — decisões de
# design". Criar credenciais OAuth 2.0 ("Web application") no Google Cloud Console;
# redirect URI autorizado: {AUTH_URL}/api/google-calendar/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 32 bytes em hex (64 caracteres) — gerar com: openssl rand -hex 32. Cifra o refresh
# token do Google antes de gravar no banco (nunca em texto plano).
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=""
