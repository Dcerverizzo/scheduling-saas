# Postgres
DATABASE_URL="postgresql://scheduling:scheduling@localhost:5432/scheduling_saas?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Auth.js
# generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# App
NODE_ENV="development"

# WhatsApp — "console" loga a mensagem no terminal do worker (padrão pra dev local,
# não abre conexão nenhuma). "baileys" conecta de verdade (produção) — nunca use
# número pessoal, ver README > WhatsApp (desenvolvimento).
WHATSAPP_PROVIDER="console"
